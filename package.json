{
  "name": "n8n-nodes-docspell",
  "version": "0.1.0",
  "description": "Interact with your Docspell instance",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "",
  "author": {
    "name": "Philipp Fehr",
    "email": "philipp@thefehr.me"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheFehr/n8n-nodes-docspell.git"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepublishOnly": "n8n-node prerelease"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/DocspellApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Docspell/Docspell.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.32.1",
    "oxlint": "^1.68.0",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "^2.23.0"
  },
  "dependencies": {
    "@devlikeapro/n8n-openapi-node": "^0.1.4"
  }
}
