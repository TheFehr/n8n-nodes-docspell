{
  "name": "n8n-nodes-docspell",
  "version": "0.43.8",
  "description": "Interact with your Docspell instance",
  "keywords": [
    "n8n-community-node-package"
  ],
  "homepage": "https://github.com/TheFehr/n8n-nodes-docspell#readme",
  "license": "MIT",
  "author": {
    "name": "Philipp Fehr",
    "email": "philipp@thefehr.me"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheFehr/n8n-nodes-docspell.git"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:oxlint": "oxlint",
    "lint:fix": "n8n-node lint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:pipeline": "bash scripts/full-test.sh",
    "test:up": "docker compose -f docker-compose.test.yml up -d db restserver joex",
    "test:down": "docker compose -f docker-compose.test.yml down",
    "prepublishOnly": "n8n-node prerelease",
    "release": "n8n-node release"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.56.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.68.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "docspellVersion": "0.43.0",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/DocspellApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Docspell/Docspell.node.js"
    ]
  },
  "n8nNodeTooling": {
    "upstream": {
      "name": "Docspell",
      "source": {
        "type": "github",
        "repo": "eikek/docspell"
      },
      "track": {
        "type": "field",
        "name": "docspellVersion"
      },
      "majorOffset": 0
    },
    "readme": "Last tested with n8n {n8n} and Docspell {upstream}.",
    "pins": {
      "restserver-image": {
        "file": "docker-compose.test.yml",
        "template": "image: ghcr.io/docspell/restserver:v{version}",
        "from": "upstream"
      },
      "joex-image": {
        "file": "docker-compose.test.yml",
        "template": "image: ghcr.io/docspell/joex:v{version}",
        "from": "upstream"
      },
      "n8n-image": {
        "file": "docker-compose.test.yml",
        "template": "image: n8nio/n8n:{version}",
        "from": "n8n"
      }
    }
  },
  "n8nWorkflowVersion": "2.47.2"
}
