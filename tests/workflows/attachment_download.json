            "node": "Download the attachment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download the attachment": {
      "main": [
        [
          {
            "node": "Assert bytes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}