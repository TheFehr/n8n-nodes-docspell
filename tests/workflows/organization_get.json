      "parameters": {
        "jsCode": "const items = $input.all();\nif (items.length !== 1 || items[0].json.name !== 'e2e-short-org') throw new Error('Unexpected organizations: ' + JSON.stringify(items.map((i) => i.json.name)));\nreturn [{ json: { verified: 'organization found by short name' } }];"
