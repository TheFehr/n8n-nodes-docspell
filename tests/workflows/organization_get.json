    {
      "parameters": {
        "jsCode": "const org = $input.first().json;\nconst problems = [];\nif (org.shortName !== 'e2eshort') problems.push('shortName=' + org.shortName);\nif (org.name !== 'e2e-short-org') problems.push('name=' + org.name);\nif (org.use !== 'correspondent') problems.push('use=' + org.use);\nif (problems.length) throw new Error('Organization detail wrong: ' + problems.join('; '));\nreturn [{ json: { verified: 'organization detail' } }];"
      },
