{
  "id": "6",
  "name": "Docspell Item Update",
  "nodes": [
    {
      "parameters": {},
      "id": "t",
      "name": "When clicking ‘Test workflow’",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        100,
