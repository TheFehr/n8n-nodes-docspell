    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (items.length !== 1) throw new Error('Expected one item, got ' + items.length);\nconst item = items[0].json;\nconst found = $('Find invoice').first().json.id;\nif (item.id !== found) throw new Error('Get returned a different item: ' + item.id + ' vs ' + found);\nif (item.name !== 'invoice-beta.txt') throw new Error('Unexpected name: ' + item.name);\nconst tags = item.tags.map((tag) => tag.name);\nif (JSON.stringify(tags) !== JSON.stringify(['e2e-invoice'])) throw new Error('Unexpected tags: ' + JSON.stringify(tags));\nif (!item.attachments || item.attachments.length !== 1) throw new Error('Expected one attachment: ' + JSON.stringify(item.attachments));\nreturn [{ json: { verified: 'item detail', id: item.id } }];"
      },
